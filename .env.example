# Copy to ".env" in this directory (Docker Compose loads it automatically).
# Do not commit ".env"; keep secrets only on your machine or in your secret store.

POSTGRES_DB=hwtask
POSTGRES_USER=hwtask
# Обязательно смените для любого окружения кроме локального прототипа.
POSTGRES_PASSWORD=change_me

# Обязательно для Docker Compose API: длинная случайная строка (≥32 байта для HS256).
# Скопируйте эту строку в .env и подставьте значение (пустой JWT_SECRET= API не стартует):
# JWT_SECRET=
# Пример генерации: openssl rand -base64 48

# Опционально:
# JWT_EXPIRATION_MS=86400000
# HWTASK_ATTACHMENTS_DIR=/data/attachments

# Optional overrides (defaults shown):
# POSTGRES_PORT=5432
# API_PORT=8080 — прямой доступ к REST / Swagger
# UI_PORT=3000 — веб-интерфейс (nginx): статика + прокси /api → сервис api
