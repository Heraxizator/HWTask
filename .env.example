# Copy to ".env" in this directory (Docker Compose loads it automatically).
# Do not commit ".env"; keep secrets only on your machine or in your secret store.

POSTGRES_DB=hwtask
POSTGRES_USER=hwtask
POSTGRES_PASSWORD=change_me

# Optional overrides (defaults shown):
# POSTGRES_PORT=5432
# API_PORT=8080 — прямой доступ к REST / Swagger
# UI_PORT=3000 — веб-интерфейс (nginx): статика + прокси /api → сервис api
